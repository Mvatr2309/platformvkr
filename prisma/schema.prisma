generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Пользователи и роли
// Источник: 00-overview.md (раздел 5)
// ============================================

enum Role {
  ADMIN
  SUPERVISOR
  STUDENT
  EXPERT      // Внешний эксперт (FR-08) — доступа к «Платформе ВКР» нет
}

enum ProfileStatus {
  DRAFT
  PENDING      // На модерации
  APPROVED     // Подтверждён
  REJECTED     // Отклонён
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role
  name          String    @default("") // ФИО — заполняется при заполнении профиля
  emailVerified Boolean   @default(false) // Подтверждение email
  profileCompleted Boolean @default(false) // Профиль заполнен — доступ к платформе
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  agreementAccepted Boolean @default(false) // Соглашение на обработку ПДн (01.06)

  supervisor    SupervisorProfile?
  student       StudentProfile?
  expert        ExpertProfile?     // FR-08: наличие записи = роль эксперта
  invitations   Invitation[]       // Приглашения, отправленные админом
  feedbacks     Feedback[]
  feedbackMessages FeedbackMessage[]

  @@index([role])
}

// Токены подтверждения email
model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-значный код
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
}

// ============================================
// FR-01: Профиль научного руководителя
// Источник: 01-FR-01-supervisors.md (раздел 2)
// ============================================

enum RecruitmentStatus {
  OPEN
  CLOSED
}

model SupervisorProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  workplace       String            // Место работы
  position        String            // Должность
  academicTitle   String            // Учёное звание (Доцент, Профессор, Нет)
  academicDegree  String            // Учёная степень (текст — к.н. каких наук и т.д.)
  resumeUrl       String?           // Ссылка на резюме или путь к файлу
  photoUrl        String?           // Путь к фото
  expertise       String[]          // Доменная экспертиза (теги)
  workPreferences String[]          // Готов работать с (мультиселект)
  proposedTopics  String?           // Предлагаемые темы (длинный текст)
  directions      String[]          // Направления студентов (мультиселект)
  projectTypes    String[]          // Типы проектов (CLASSIC_DISSERTATION, STARTUP, CORPORATE_STARTUP)
  maxSlots        Int               @default(3) // Макс. одновременных проектов (руководство)
  maxProjects     Int               @default(3) // Макс. проектов под авторством НР (1–3)
  contact         String            // Контакт (e-mail, Telegram, телефон)

  status          ProfileStatus     @default(DRAFT)
  recruitmentStatus RecruitmentStatus @default(OPEN)
  moderationComment String?         // Комментарий при отклонении (01.05)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  projects        Project[]         // Связь с проектами (FR-02)
  applications    Application[]     // Заявки на рассмотрение
  favoritedBy     FavoriteSupervisor[] // Студенты, добавившие НР в избранное

  @@index([status])
}

// ============================================
// FR-05: Профиль студента
// Источник: 05-FR-05-matching-students.md (05.06)
// ============================================

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction     String        // Направление (образовательная программа)
  course        Int           // Курс
  cohort        String        @default("") // Когорта (Поток2025, Поток2026)
  about         String?       // О себе (опыт, экспертиза)
  competencies  String[]      // Компетенции
  desiredRoles  String[]      // Желаемые роли в проекте
  portfolioUrl  String?       // Портфолио (ссылка)
  contact       String        // Контакт для связи

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projects      ProjectMember[]  // Участие в проектах
  applications  Application[]    // Поданные заявки
  favorites     FavoriteSupervisor[] // Избранные научные руководители
  expertRequests ExpertRequest[] // FR-08: запросы на консультацию
}

// ============================================
// Избранные научные руководители (студент → НР)
// ============================================

model FavoriteSupervisor {
  id           String            @id @default(cuid())
  studentId    String
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   SupervisorProfile @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([studentId, supervisorId])
  @@index([studentId])
  @@index([supervisorId])
}

// ============================================
// FR-01: Приглашения научных руководителей
// Источник: 01-FR-01-supervisors.md (01.01)
// ============================================

enum InvitationStatus {
  SENT
  ACCEPTED
  EXPIRED
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  name        String           @default("") // ФИО (необязательно при создании)
  token       String           @unique @default(cuid()) // Уникальная ссылка
  status      InvitationStatus @default(SENT)
  sentById    String
  sentBy      User             @relation(fields: [sentById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([status])
  @@index([email])
}

// ============================================
// FR-02: Проекты
// Источник: 02-FR-02-projects.md (раздел 2)
// ============================================

enum ProjectType {
  CLASSIC_DISSERTATION  // Классическая диссертация
  STARTUP               // Стартап
  CORPORATE_STARTUP     // Корпоративный стартап
}

enum ProjectStatus {
  DRAFT
  PENDING      // На модерации
  OPEN         // Открыт (ищет участников)
  ACTIVE       // Активный (в работе)
  COMPLETED    // Завершён
}

enum AssignmentStatus {
  NONE                // Нет назначения / НР сам создал проект
  PENDING_SUPERVISOR  // Ожидает подтверждения НР (04.03)
  CONFIRMED           // НР подтвердил
  DECLINED            // НР отклонил
}

model Project {
  id              String          @id @default(cuid())
  title           String          // Название проекта
  description     String          // Описание (длинный текст)
  projectType     ProjectType     // Тип работы
  status          ProjectStatus   @default(DRAFT)
  direction       String?         // Направление (для классических диссертаций)
  requiredRoles   String[]        // Требуемые роли (мультиселект)
  contact         String          // Контакт для связи
  assignmentStatus AssignmentStatus @default(NONE) // 04.03: статус назначения НР
  recruitmentClosed Boolean       @default(false) // Автор закрыл набор участников

  supervisorId    String?
  supervisor      SupervisorProfile? @relation(fields: [supervisorId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         ProjectMember[]  // Участники (студенты)
  applications    Application[]    // Заявки на проект
  files           ProjectFile[]    // Файлы и материалы (03.04)
  events          Event[]          // Привязанные события (06.03)
  activities      Activity[]       // Лента активности (03.06)
  expertRequests  ExpertRequest[]  // FR-08: запросы на консультацию по этому проекту

  @@index([supervisorId])
  @@index([status])
  @@index([supervisorId, status])
}

model ProjectMember {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId   String?        // null для ручных участников (без аккаунта)
  student     StudentProfile? @relation(fields: [studentId], references: [id])
  role        String?        // Роль в проекте (Разработчик, Product-менеджер и т.д.)
  isCreator   Boolean        @default(false) // Автор (создатель) проекта
  joinedAt    DateTime       @default(now())

  // Поля для ручных участников (добавленных автором без аккаунта)
  manualName      String?   // ФИО
  manualEmail     String?   // E-mail
  manualDirection String?   // Направление / программа
  inSystem        Boolean   @default(true) // true = в системе, false = не в системе

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
}

// ============================================
// FR-03: Файлы проекта
// Источник: 03-FR-03-project-page.md (03.04)
// ============================================

model ProjectFile {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String          // Название слота (напр. «Концепция исследования»)
  fileType    ProjectFileType @default(FILE)
  filename    String?         // Имя загруженного файла (для FILE)
  filepath    String?         // Путь на диске (для FILE)
  url         String?         // Внешняя ссылка (для LINK)
  uploadedAt  DateTime        @default(now())
}

enum ProjectFileType {
  FILE
  LINK
}

// ============================================
// FR-03: Лента активности проекта
// Источник: 03-FR-03-project-page.md (03.06)
// ============================================

model Activity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action      String   // Описание действия
  actorEmail  String?  // E-mail пользователя, совершившего действие
  createdAt   DateTime @default(now())
}

// ============================================
// FR-05: Заявки (студент → проект)
// Источник: 05-FR-05-matching-students.md (05.01–05.05)
// ============================================

enum ApplicationType {
  STUDENT
  SUPERVISOR
  SUPERVISION_REQUEST   // Студент предлагает свой проект НР
}

enum ApplicationStatus {
  PENDING
  APPROVED_BY_AUTHOR
  ACCEPTED
  REJECTED
  INTERESTED            // НР заинтересован — контакты раскрыты, ожидание встречи
  AWAITING_STUDENT      // НР готов взять проект — ждём финального подтверждения студента
  CONFIRMED             // Руководство закреплено (после подтверждения студента)
  DECLINED              // НР отказался после встречи
}

model Application {
  id              String            @id @default(cuid())
  type            ApplicationType   @default(STUDENT)
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId       String?           // Заполняется для STUDENT-заявок
  student         StudentProfile?   @relation(fields: [studentId], references: [id])
  supervisorId    String?           // Для STUDENT — НР проекта; для SUPERVISOR — сам заявитель
  supervisor      SupervisorProfile? @relation(fields: [supervisorId], references: [id])

  motivation      String            // Мотивационное письмо (05.01)
  role            String?           // Желаемая роль в проекте
  status          ApplicationStatus @default(PENDING)
  comment         String?           // Комментарий при принятии/отклонении (05.02)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Студент может предложить один проект нескольким НР (разные supervisorId).
  // Уникальность по тройке не даёт дубль одному и тому же НР; STUDENT-заявки
  // (один отклик на проект) дополнительно защищены проверкой в коде.
  @@unique([projectId, studentId, supervisorId])
  @@index([projectId])
  @@index([studentId])
  @@index([supervisorId])
  @@index([status])
  @@index([type])
}

// ============================================
// FR-06: Календарь событий
// Источник: 06-FR-06-calendar.md (06.01–06.03)
// ============================================

enum EventType {
  DEADLINE
  DEFENSE       // Защита
  CONSULTATION  // Консультация
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime? // Дата окончания для многодневных событий
  eventType   EventType
  direction   String?   // Привязка к направлению
  projectId   String?   // Привязка к проекту (06.03)
  project     Project?  @relation(fields: [projectId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([date])
  @@index([projectId])
}

// ============================================
// FR-07: База знаний
// Источник: 07-FR-07-knowledge-base.md (07.01–07.05)
// ============================================

enum ArticleCategory {
  REGULATION    // Регламенты
  TEMPLATE      // Шаблоны
  FAQ           // FAQ
  INSTRUCTION   // Инструкции
}

enum MaterialType {
  ARTICLE   // Статья (свёрстанный текст)
  FILE      // Просто файл для скачивания
  BOOK      // Книга: многосоставный материал (главы и страницы — дочерние Article)
}

model Article {
  id          String          @id @default(cuid())
  title       String
  content     String          @default("") // Содержимое (HTML из WYSIWYG); пусто для FILE
  category    ArticleCategory
  type        MaterialType    @default(ARTICLE)
  visibleToStudents    Boolean @default(true) // Видно студентам
  visibleToSupervisors Boolean @default(true) // Видно научным руководителям
  // Дерево книги: книга → главы → страницы. У корневых материалов parentId = null.
  parentId    String?
  parent      Article?        @relation("ArticleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Article[]       @relation("ArticleTree")
  sortOrder   Int             @default(0) // Порядок внутри родителя
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  files       ArticleFile[]   // Прикреплённые шаблоны (07.04)

  @@index([parentId])
}

model ArticleFile {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  filename    String
  filepath    String
  uploadedAt  DateTime @default(now())
}

// ============================================
// Справочники (для админа)
// Источник: 11-CJM-admin.md (этап 1)
// ============================================

model Dictionary {
  id      String           @id @default(cuid())
  type    String           @unique // directions, competencies, workTypes, roles
  values  DictionaryValue[]
}

model DictionaryValue {
  id           String     @id @default(cuid())
  dictionaryId String
  dictionary   Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  value        String
  sortOrder    Int        @default(0)
}

// ============================================
// Уведомления (in-app)
// ============================================

enum NotificationType {
  APPLICATION_NEW        // Новая заявка (для НР)
  APPLICATION_ACCEPTED   // Заявка принята (для студента)
  APPLICATION_REJECTED   // Заявка отклонена (для студента)
  PROFILE_APPROVED       // Профиль одобрен (для НР)
  PROFILE_REJECTED       // Профиль отклонён (для НР)
  PROJECT_STATUS         // Изменение статуса проекта
  DEADLINE_REMINDER      // Напоминание о дедлайне
  SYSTEM                 // Системное уведомление

  // FR-08: Экспертная труба. Все значения EXPERT_* относятся к пространству трубы (08.22)
  EXPERT_REQUEST_NEW        // Новый запрос — модератору
  EXPERT_REQUEST_APPROVED   // Одобрен модератором — эксперту
  EXPERT_REQUEST_REJECTED   // Отклонён модератором или экспертом — студенту
  EXPERT_REQUEST_ACCEPTED   // Принят, контакты — студенту и эксперту
  EXPERT_FEEDBACK_REQUEST   // Запрос обратной связи и напоминание
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?          // Ссылка для перехода
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================
// Обратная связь
// ============================================

enum FeedbackCategory {
  BUG           // Баг
  SUGGESTION    // Предложение
  QUESTION      // Вопрос
}

enum FeedbackStatus {
  NEW           // Новое
  IN_PROGRESS   // В работе
  RESOLVED      // Решено
}

model Feedback {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    FeedbackCategory
  message     String           // Первое сообщение (исходный вопрос)
  status      FeedbackStatus   @default(NEW)
  response    String?          // Устарело: первый ответ админа (теперь в messages)
  respondedAt DateTime?        // Устарело: когда был дан первый ответ
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    FeedbackMessage[]

  @@index([userId])
  @@index([status])
}

model FeedbackMessage {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())

  @@index([feedbackId, createdAt])
}

// ============================================
// FR-08: Экспертная труба
// Источник: specs/08-FR-08-expert-pipeline.md (раздел 5)
// ============================================

// Карточка эксперта. Наличие записи = роль эксперта (08.05).
// Набор полей повторяет SupervisorProfile, кроме полей про руководство проектом
// и модерацию: карточка эксперта не модерируется.
model ExpertProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workplace       String   @default("")    // Место работы (она же компания)
  position        String   @default("")    // Должность
  academicTitle   String   @default("")    // Учёное звание — у внешнего эксперта может не быть
  academicDegree  String   @default("")    // Учёная степень — у внешнего эксперта может не быть
  resumeUrl       String?                  // Ссылка на резюме или путь к файлу
  photoUrl        String?                  // Путь к фото
  expertise       String[]                 // Доменная экспертиза (теги) — фильтр каталога (08.10)
  helpTopics      String?                  // «С какими темами могу помочь» — опционально
  directions      String[]                 // Направления студентов
  projectTypes    String[]                 // Типы проектов
  contact         String   @default("")    // Контакт — виден только после принятия запроса (08.11)

  cardCompleted   Boolean  @default(false) // Обязательный минимум заполнен → карточка в каталоге
  hiddenByOwner   Boolean  @default(false) // Эксперт скрыл карточку, например в отпуске (08.09)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests        ExpertRequest[]

  @@index([cardCompleted, hiddenByOwner])
}

enum ExpertRequestStatus {
  NEW                     // Новый — ждёт модератора
  APPROVED_BY_MODERATOR   // Одобрен модератором — ждёт эксперта
  REJECTED_BY_MODERATOR   // Отклонён модератором (терминальный)
  REJECTED_BY_EXPERT      // Отклонён экспертом (терминальный)
  CONTACTS_SENT           // Контакты отправлены
  AWAITING_FEEDBACK       // Ожидает обратной связи
  CLOSED                  // Закрыт
}

// Запрос студента на консультацию. Отдельно от Application: заявки на научное
// руководство и экспертные запросы не смешиваются (08.18).
model ExpertRequest {
  id                String   @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expertId          String
  expert            ExpertProfile  @relation(fields: [expertId], references: [id], onDelete: Cascade)

  // Анкета (08.12)
  topic             String   // Что хочу обсудить (от 500 символов)
  expectedResult    String   // Какой результат жду от встречи (от 80 символов)
  ownProgress       String   // Что уже сделал сам, чтобы разобраться (от 500 символов)
  problemArea       String?  // Где возникли проблемы — необязательно
  materialsUrl      String?  // Ссылка на папку с материалами — необязательно
  projectId         String?  // Проект студента на платформе — необязательно
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Снимок профиля на момент отправки: курс и программа со временем меняются,
  // а модератор и эксперт должны видеть то, что было при отправке
  directionSnapshot String
  courseSnapshot    Int

  status            ExpertRequestStatus @default(NEW)
  moderatorComment  String?  // Причина отклонения — обязательна при REJECTED_BY_MODERATOR
  expertComment     String?  // Причина отказа эксперта

  moderatedById     String?
  moderatedAt       DateTime?
  acceptedAt        DateTime?
  contactsSentAt    DateTime?  // Точка отсчёта 7 дней до сбора обратной связи
  feedbackRequestedAt    DateTime?
  feedbackReminderSentAt DateTime?
  closedAt          DateTime?
  closedWithoutFeedback  Boolean @default(false) // Закрыт джобой, а не студентом (08.20)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  feedbacks         ExpertRequestFeedback[]

  @@index([status])
  @@index([expertId, status])
  @@index([studentId])
  @@index([status, contactsSentAt])       // Для джобы сбора обратной связи
  @@index([status, feedbackRequestedAt])  // Для джобы напоминания и авто-закрытия
}

enum FeedbackAuthorSide {
  STUDENT
  EXPERT
}

// Обратная связь по консультации (08.16). Имя намеренно не Feedback —
// эта модель уже занята тикетами поддержки.
model ExpertRequestFeedback {
  id          String   @id @default(cuid())
  requestId   String
  request     ExpertRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorSide  FeedbackAuthorSide

  metHappened Boolean          // Состоялась ли встреча
  rating      Int?             // 1–5, только от студента
  comment     String?

  createdAt   DateTime @default(now())

  @@unique([requestId, authorSide])  // По одному ответу с каждой стороны
  @@index([requestId])
}

// Какие потоки студентов видят экспертную трубу (08.07).
// Значение cohort совпадает со значением справочника cohorts.
model ExpertPipelineCohortAccess {
  id        String   @id @default(cuid())
  cohort    String   @unique
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
